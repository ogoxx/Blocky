    <string name="delete_permanent_dialog_desc">Esta acción elimina el registro de llamada de tu historial.\n\nComo este número no está en tus contactos ni en la lista blanca, las futuras llamadas de este número continuarán siendo bloqueadas.</string>
    <string name="delete_permanent_dialog_confirm">Eliminar</string>
