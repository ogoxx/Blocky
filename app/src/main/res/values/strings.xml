    <!-- Google Play Compliance & Prominent Disclosures -->
    <string name="disclosure_title">Privacy &amp; Data Safety Disclosure</string>
    <string name="disclosure_contacts_title">Contacts Access</string>
    <string name="disclosure_contacts_desc" formatted="false">Blocky requires access to your Contacts strictly to verify whether incoming callers are saved in your phonebook. All contact information is processed 100% locally on your device in real-time. Blocky NEVER collects, uploads, sells, or shares your personal contacts with external servers or third parties.</string>
    <string name="disclosure_notifications_title">Notifications</string>
    <string name="disclosure_notifications_desc">Blocky uses notifications to show an ongoing status indicator that call protection is active and alert you when an unknown call is screened.</string>
    <string name="disclosure_call_screening_title">Call Screening Service</string>
    <string name="disclosure_call_screening_desc">Blocky operates as a Call Screening Service to inspect incoming call numbers and silently block non-whitelisted spam or unknown callers before your phone rings.</string>
    <string name="disclosure_accept_btn">I Agree &amp; Continue</string>
    <string name="disclosure_decline_btn">Not Now</string>
    <string name="privacy_policy_title">Privacy Policy &amp; Data Safety</string>
    <string name="privacy_policy_btn">Privacy Policy</string>
    <string name="privacy_policy_content" formatted="false">Blocky is designed with a strict privacy-first architecture.\n\n1. 100% On-Device Processing:\nAll call screening, contact matching, whitelist checking, and call log histories are processed exclusively on your local device. Blocky operates completely offline with zero remote cloud servers.\n\n2. Zero Data Collection &amp; Telemetry:\nBlocky does NOT collect, track, store remotely, or transmit your personal data, contact list, phone numbers, or call history. There are no advertising trackers, analytics SDKs, or background telemetry.\n\n3. Android Permissions &amp; Usage:\n• Read Contacts (READ_CONTACTS): Checked in real-time locally solely to avoid screening calls from your saved contacts. Your contacts never leave your phone.\n• Call Screening Service: Allows the Android Telecom framework to pass incoming numbers to Blocky for instant local filtering.\n• Notifications (POST_NOTIFICATIONS): Used to display the persistent protection status icon and optional sound alerts.\n• Battery Optimization Exemption: Keeps the screening engine reliable in the background.\n\n4. Data Sovereignty &amp; Backups:\nYour blocked and allowed numbers remain in your device\'s local storage. Any CSV backup exported or imported is stored solely on your device or shared directly through your personal actions.\n\n5. Third-Party Sharing:\nNo personal data is ever sold, rented, or shared with third parties or advertisers.\n\n6. Contact &amp; Support:\nFor questions or support, contact the developer at prismaticamedia@gmail.com.</string>
